# ==========================================
# Motor OaaS de Licitações Públicas - Config
# ==========================================

# Estado e Filtros Padrão
TARGET_UF=MT
TARGET_KEYWORDS=informatica,computador,notebook,nobreak,servidor,ti,software
NEGATIVE_KEYWORDS=obras,pavimentacao,limpeza,combustivel,merenda,reforma

# Intervalo de Consulta PNCP (dias para trás se não especificado)
PNCP_LOOKBACK_DAYS=5
PNCP_PAGE_SIZE=10

# Banco de Dados (Supabase PostgreSQL como fonte primária com espelho local)
DATABASE_URL=sqlite:///./bid_engine.db
SUPABASE_URL=https://sua-instancia.supabase.co
SUPABASE_KEY=sua-service-role-ou-anon-key

# Consultas via Apify (Provedor oficial de busca e raspagem de editais)
CONSULTA_PROVIDER=apify
APIFY_API_TOKEN=apify_api_token_aqui
APIFY_ACTOR_ID=brasil-dados~pncp-editais
APIFY_TIMEOUT=60.0

# LLM / Agentes (OpenRouter / OpenAI / Anthropic / Gemini / Ollama)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=minimax/minimax-m3.1-flash:free
LLM_PROVIDER=openrouter

# Notificador WhatsApp / Z-API / Evolution API / Webhook
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://api.z-api.io/instances/YOUR_INSTANCE/token/YOUR_TOKEN/send-text
WHATSAPP_API_TOKEN=
WHATSAPP_RECIPIENT_PHONE=5565999999999

# Configurações TinyFish (Opcional para portais JS legados)
TINYFISH_API_KEY=

# Diretório para Download de Editais e Anexos
DOWNLOAD_DIR=./downloads
